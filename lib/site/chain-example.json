,"look":["pc"],"view":"close","zoom":0.55},{"line":"It overheats, and crashes.","act":[{"id":"pc","op":"smoke"},{"id":"pc","op":"dim"}],"look":["pc"],"view":"close","zoom":0.45},{"line":"So you line up hundreds of computers in tall metal racks.","hide":["pc"],"show":["racks"],"look":["racks"],"view":"close","name":"Server racks"},{"line":"Rain and dust would kill them, so you wrap them in a concrete hall, with a big steel door.","show":["wall_back","wall_l","wall_r","roof","door"],"how":"rise","look":["wall_back","wall_l","wall_r","roof"]},{"line":"But all those computers turn the hall into an oven.","act":[{"id":"racks","op":"heat"},{"id":"roof","op":"smoke"}],"look":["racks"],"view":"close"},{"line":"So giant fans on the roof suck the heat out.","show":["chillers"],"act":[{"id":"chillers","op":"spin","speed":5},{"op":"flow","along":"hotair","what":"heat","speed":0.5}],"look":["chillers","roof"],"view":"high","name":"Cooling fans"},{"line":"And cold air blows in through ducts, between the racks.","show":["airduct"],"how":"grow","act":[{"id":"chillers","op":"spin","speed":5},{"id":"racks","op":"cool"},{"op":"flow","along":"airduct","what":"cold"}],"look":["airduct","racks"],"view":"close"},{"line":"Then the city's power goes out. Everything goes dark.","act":[{"id":"racks","op":"dim"}],"look":["racks","roof"],"view":"close"},{"line":"So rows of batteries keep it alive for a few minutes,","show":["batteries"],"act":[{"id":"racks","op":"lights"}],"look":["batteries"],"view":"left","zoom":0.9,"name":"Batteries"},{"line":"while huge diesel generators outside roar to life.","show":["gens","power1","power2","power3"],"act":[{"id":"gens","op":"smoke"},{"id":"gens","op":"shake","amp":0.03},{"op":"flow","along":"power1","what":"power"},{"op":"flow","along":"power2","what":"power"},{"op":"flow","along":"power3","what":"power"},{"id":"chillers","op":"spin","speed":5}],"look":["gens"],"view":"close","name":"Diesel generators"},{"line":"Now the world has to reach it. So you run fibre cables from the racks,","show":["tray","fibre1","fibre2"],"how":"grow","act":[{"op":"flow","along":"fibre1","what":"data","speed":0.25},{"id":"chillers","op":"spin","speed":5}],"look":[{"at":[-4,2.6,0],"r":3.5}],"view":"front","name":"Fibre optic cables","look2":[{"at":[-10.3,1.6,1],"r":2.5}]},{"line":"down the wall, under the ground, and out to the rest of the internet.","act":[{"op":"flow","along":"fibre1","what":"data","speed":0.25},{"op":"flow","along":"fibre2","what":"data","speed":0.2},{"id":"chillers","op":"spin","speed":5}],"look":[{"at":[-10.5,1.2,5],"r":3}],"look2":[{"at":[-13,-2.5,13.9],"r":4.5}],"view":"under"},{"line":"A fire could wipe it all out, and water would ruin the computers. So red pipes fill the room with a gas that smothers flames.","show":["gastanks","firepipes","nozzles"],"act":[{"op":"flow","along":"firepipes","what":"gas","speed":0.4},{"id":"chillers","op":"spin","speed":5}],"look":[{"at":[-4.6,3,-3.5],"r":3.8}],"view":"front","name":"Fire suppression"},{"line":"Then you build a tall fence all the way around,","show":["fence_a","fence_b","fence_r","fence_back","fence_l"],"act":[{"id":"chillers","op":"spin","speed":5}],"look":[{"at":[-14,1.5,13.4],"r":5}],"look2":[{"at":[12,1.5,12],"r":7}],"view":"close","name":"Security fence"},{"line":"with cameras on every corner, watching day and night.","show":["cams_front","cams_back"],"act":[{"id":"chillers","op":"spin","speed":5}],"look":[{"at":[17.5,3.5,12.9],"r":2.5}],"look2":[{"at":[-17.5,3.5,12.9],"r":2.5}],"view":"close","name":"Security cameras"},{"line":"And a guard at the gate checks everyone who comes in.","show":["booth","guard"],"act":[{"id":"guard","op":"walk","to":[8.2,0.4,12.4]},{"id":"booth","op":"open"},{"id":"chillers","op":"spin","speed":5}],"look":[{"at":[6.5,1.4,11.8],"r":2.8}],"view":"close","name":"Guard house"},{"line":"Congratulations! You just built a data centre.","act":[{"op":"flow","along":"fibre1","what":"data","keep":true},{"op":"flow","along":"fibre2","what":"data","keep":true},{"id":"chillers","op":"spin","speed":5},{"id":"guard","op":"patrol","by":1.2}],"look":["pad","roof","chillers"],"view":"high","zoom":1.35},{"line":"Follow, and next time we build something new.","act":[{"op":"flow","along":"fibre1","what":"data","keep":true},{"id":"chillers","op":"spin","speed":5}],"look":["pad","roof"],"view":"wide","zoom":1.2}]}